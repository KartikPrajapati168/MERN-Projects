# Get a free key from https://aistudio.google.com/app/apikey
# Vite only exposes env vars prefixed with VITE_ to the browser.
# NOTE: since there is no backend, this key IS visible in the browser
# (DevTools -> Network/Sources). That's fine for a local college demo,
# but never do this in a real production app.
VITE_GEMINI_API_KEY=your_key_from_aistudio.google.com
